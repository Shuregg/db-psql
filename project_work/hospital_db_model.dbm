<view name="doctors_patients_sorted_view" layers="0" collapse-mode="2" max-obj-count="3" z-value="0">
	<schema name="public"/>
	<role name="alexander"/>
	<position x="1080" y="760"/>
	<reference object="public.doctors" type="table" ref-name="doctors" use-signature="true"/>
	<reference object="public.patients" type="table" ref-name="patients" use-signature="true"/>
	<reference object="public.visits" type="table" ref-name="visits" use-signature="true"/>
	<simplecol name="doctor_first_name" type="character varying"/>
	<simplecol name="doctor_last_name" type="character varying"/>
	<simplecol name="patient_first_name" type="character varying"/>
	<simplecol name="patient_last_name" type="character varying"/>
	<simplecol name="visit_date" type="date"/>
	<definition> <![CDATA[ SELECT d.first_name AS doctor_first_name,
    d.last_name AS doctor_last_name,
    p.first_name AS patient_first_name,
    p.last_name AS patient_last_name,
    v.visit_date
   FROM ((doctors d
     JOIN visits v ON ((d.doctor_id = v.doctor_id)))
     JOIN patients p ON ((v.patient_id = p.patient_id)))
  ORDER BY v.visit_date;]]> </definition>
</view>

