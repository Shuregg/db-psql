<procedure name="add_patient" security-type="SECURITY INVOKER">
	<schema name="public"/>
	<role name="alexander"/>
	<language name="plpgsql"/>
	<parameter name="first_name">
		<type name="character varying" length="0"/>
	</parameter>
	<parameter name="last_name">
		<type name="character varying" length="0"/>
	</parameter>
	<parameter name="patronymic">
		<type name="character varying" length="0"/>
	</parameter>
	<parameter name="birth_date">
		<type name="date" length="0"/>
	</parameter>
	<parameter name="gender">
		<type name="public.gender_enum" length="0"/>
	</parameter>
	<parameter name="phone_number">
		<type name="character varying" length="0"/>
	</parameter>
	<definition> <![CDATA[BEGIN
    INSERT INTO patients (first_name, last_name, patronymic, birth_date, gender, phone_number)
    VALUES (first_name, last_name, patronymic, birth_date, gender, phone_number);
END;]]> </definition>
</procedure>

<procedure name="add_doctor" security-type="SECURITY INVOKER">
	<schema name="public"/>
	<role name="alexander"/>
	<language name="plpgsql"/>
	<parameter name="first_name">
		<type name="character varying" length="0"/>
	</parameter>
	<parameter name="last_name">
		<type name="character varying" length="0"/>
	</parameter>
	<parameter name="patronymic">
		<type name="character varying" length="0"/>
	</parameter>
	<parameter name="current_position">
		<type name="character varying" length="0"/>
	</parameter>
	<parameter name="department_id">
		<type name="integer" length="0"/>
	</parameter>
	<parameter name="is_doctor">
		<type name="boolean" length="0"/>
	</parameter>
	<definition> <![CDATA[BEGIN
    INSERT INTO doctors (first_name, last_name, patronymic, current_position, department_id, is_doctor)
    VALUES (first_name, last_name, patronymic, current_position, department_id, is_doctor);
END;]]> </definition>
</procedure>

<procedure name="add_diagnosis" security-type="SECURITY INVOKER">
	<schema name="public"/>
	<role name="alexander"/>
	<language name="plpgsql"/>
	<parameter name="diagnosis_name">
		<type name="character varying" length="0"/>
	</parameter>
	<parameter name="doctor_id">
		<type name="integer" length="0"/>
	</parameter>
	<parameter name="patient_id">
		<type name="integer" length="0"/>
	</parameter>
	<definition> <![CDATA[BEGIN
    INSERT INTO diagnoses (diagnosis_name, doctor_id, patient_id)
    VALUES (diagnosis_name, doctor_id, patient_id);
END;]]> </definition>
</procedure>

<procedure name="add_visit" security-type="SECURITY INVOKER">
	<schema name="public"/>
	<role name="alexander"/>
	<language name="plpgsql"/>
	<parameter name="visit_date">
		<type name="date" length="0"/>
	</parameter>
	<parameter name="discharge_date">
		<type name="date" length="0"/>
	</parameter>
	<parameter name="patient_id">
		<type name="integer" length="0"/>
	</parameter>
	<parameter name="doctor_id">
		<type name="integer" length="0"/>
	</parameter>
	<definition> <![CDATA[BEGIN
    INSERT INTO visits (visit_date, discharge_date, patient_id, doctor_id)
    VALUES (visit_date, discharge_date, patient_id, doctor_id);
END;]]> </definition>
</procedure>

<procedure name="add_medication" security-type="SECURITY INVOKER">
	<schema name="public"/>
	<role name="alexander"/>
	<language name="plpgsql"/>
	<parameter name="medication_name">
		<type name="character varying" length="0"/>
	</parameter>
	<parameter name="indications">
		<type name="character varying" length="0"/>
	</parameter>
	<parameter name="form">
		<type name="character varying" length="0"/>
	</parameter>
	<parameter name="production_date">
		<type name="date" length="0"/>
	</parameter>
	<parameter name="expiration_date">
		<type name="date" length="0"/>
	</parameter>
	<parameter name="price">
		<type name="numeric" length="0"/>
	</parameter>
	<parameter name="amount">
		<type name="integer" length="0"/>
	</parameter>
	<definition> <![CDATA[BEGIN
    INSERT INTO medications (medication_name, indications, form, production_date, expiration_date, price, amount)
    VALUES (medication_name, indications, form, production_date, expiration_date, price, amount);
END;]]> </definition>
</procedure>

<view name="patients_age_view" layers="0" collapse-mode="2" max-obj-count="1" z-value="0">
	<schema name="public"/>
	<role name="alexander"/>
	<position x="2120" y="820"/>
	<reference object="public.patients" type="table" ref-name="patients" use-signature="true"/>
	<simplecol name="first_name" type="character varying"/>
	<simplecol name="last_name" type="character varying"/>
	<simplecol name="birth_date" type="date"/>
	<simplecol name="age" type="numeric"/>
	<definition> <![CDATA[ SELECT first_name,
    last_name,
    birth_date,
    EXTRACT(year FROM age((birth_date)::timestamp with time zone)) AS age
   FROM patients p;]]> </definition>
</view>

