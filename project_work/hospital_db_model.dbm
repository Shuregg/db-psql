<view name="doctor_patient_count_view" layers="0" collapse-mode="2" max-obj-count="2" z-value="0">
	<schema name="public"/>
	<role name="alexander"/>
	<position x="160" y="1080"/>
	<reference object="public.doctors" type="table" ref-name="doctors" use-signature="true"/>
	<reference object="public.visits" type="table" ref-name="visits" use-signature="true"/>
	<simplecol name="first_name" type="character varying"/>
	<simplecol name="last_name" type="character varying"/>
	<simplecol name="patient_count" type="bigint"/>
	<definition> <![CDATA[ SELECT d.first_name,
    d.last_name,
    count(v.patient_id) AS patient_count
   FROM (doctors d
     JOIN visits v ON ((d.doctor_id = v.doctor_id)))
  GROUP BY d.doctor_id;]]> </definition>
</view>

