	<reference object="public.visits_rooms" type="table" ref-name="visits_rooms" use-signature="true"/>
	<simplecol name="first_name" type="character varying"/>
	<simplecol name="last_name" type="character varying"/>
	<simplecol name="room_number" type="character varying(10)"/>
	<simplecol name="diagnosis_name" type="character varying"/>
	<definition> <![CDATA[ SELECT p.first_name,
    p.last_name,
    r.room_number,
    d.diagnosis_name
   FROM (((patients p
     JOIN visits_rooms vr ON ((p.patient_id = vr.visit_id)))
     JOIN rooms r ON ((vr.room_id = r.room_id)))
     JOIN diagnoses d ON ((p.patient_id = d.patient_id)));]]> </definition>
</view>

