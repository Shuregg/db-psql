	</column>
	<column name="number_of_beds">
		<type name="smallint" length="0"/>
	</column>
	<constraint name="chk_number_of_beds" type="ck-constr" table="public.rooms">
			<expression> <![CDATA[(((room_type = 'ward'::room_type_enum) AND (number_of_beds IS NOT NULL) AND (number_of_beds > 0)) OR ((room_type <> 'ward'::room_type_enum) AND (number_of_beds IS NULL)))]]> </expression>
	</constraint>
	<constraint name="rooms_pkey" type="pk-constr" table="public.rooms">
		<columns names="room_id" ref-type="src-columns"/>
	</constraint>
	<constraint name="rooms_room_number_key" type="uq-constr" table="public.rooms">
		<columns names="room_number" ref-type="src-columns"/>
	</constraint>
</table>

