	<reference object="public.patients" type="table" ref-name="patients" use-signature="true"/>
	<reference object="public.diagnoses" type="table" ref-name="diagnoses" use-signature="true"/>
	<simplecol name="diagnosis_name" type="character varying"/>
	<simplecol name="patient_count" type="bigint"/>
	<definition> <![CDATA[ SELECT d.diagnosis_name,
    count(p.patient_id) AS patient_count
   FROM (diagnoses d
     JOIN patients p ON ((d.patient_id = p.patient_id)))
  GROUP BY d.diagnosis_id;]]> </definition>
</view>

