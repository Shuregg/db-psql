<table name="rooms" layers="0" collapse-mode="2" max-obj-count="7" z-value="0">
	<schema name="public"/>
	<role name="alexander"/>
	<position x="1200" y="340"/>
	<column name="room_id" not-null="true" sequence="public.rooms_room_id_seq">
		<type name="integer" length="0"/>
	</column>
	<column name="department_id">
		<type name="integer" length="0"/>
	</column>
	<column name="room_number" not-null="true">
