<view name="medication_treatment_count_view" layers="0" collapse-mode="2" max-obj-count="2" z-value="0">
	<schema name="public"/>
	<role name="alexander"/>
	<position x="2180" y="1620"/>
	<reference object="public.medications" type="table" ref-name="medications" use-signature="true"/>
	<reference object="public.treatment_courses" type="table" ref-name="treatment_courses" use-signature="true"/>
	<simplecol name="medication_name" type="character varying"/>
	<simplecol name="treatment_count" type="bigint"/>
	<definition> <![CDATA[ SELECT m.medication_name,
    count(tc.visit_id) AS treatment_count
   FROM (medications m
     JOIN treatment_courses tc ON ((m.medication_id = tc.medication_id)))
  GROUP BY m.medication_id;]]> </definition>
</view>

